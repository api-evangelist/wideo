  "info": {
    "_postman_id": "52d9884f-660b-4057-b1e1-e2e02f9e2d0f",
    "name": "Wideo Video Automation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Wideo's Video Automation API generates finished MP4 videos at scale from reusable templates and structured data. A rendering batch is created from a template plus a list of per-video variable objects; rendering is asynchronous and completion is signalled by a webhook callback and/or by polling batch status for signed video and preview URLs. A legacy replace/encode flow lets a template's variables be replaced and then encoded into a single video.\n\nContact Support:\n Name: Wideo API Support",
      "type": "text/plain"
    }
  }
