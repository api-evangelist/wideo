          "name": "Create a rendering batch",
          "request": {
            "name": "Create a rendering batch",
            "description": {
              "content": "Create a rendering batch from a template and per-video metadata. Returns a batchId immediately; rendering runs asynchronously. When rendering finishes, Wideo delivers a webhook callback to the supplied webhook URL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateId\": \"<string>\",\n  \"videos\": [\n    {\n      \"key_0\": false,\n      \"key_1\": 9937.41216936127\n    },\n    {\n      \"key_0\": 5556.367498532612,\n      \"key_1\": \"string\"\n    }\n  ],\n  \"webhook\": \"<uri>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
