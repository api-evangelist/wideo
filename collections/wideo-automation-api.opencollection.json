{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wideo Video Automation API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Automation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Replace template variables",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://automationapi.wideo.co/automation/replace",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Legacy flow. Replace a template's variable content with supplied values, producing a replace object whose id (REPLACE_OBJECT_ID) is then passed to the encode call."
        },
        {
          "info": {
            "name": "Encode a video",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://automationapi.wideo.co/automation/encode",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Legacy flow. Encode one or more MP4 videos from a template and a previously created replace object, returning the finished video URL."
        }
      ]
    }
  ],
  "bundled": true
}